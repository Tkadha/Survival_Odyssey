root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,hlsl}]
# MSVC는 /utf-8 플래그가 없으면 BOM으로만 UTF-8을 인식한다 (한글 주석 보호).
charset = utf-8-bom
indent_style = tab
indent_size = 4
tab_width = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
